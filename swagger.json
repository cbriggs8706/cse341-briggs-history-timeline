{
  "swagger": "2.0",
  "info": {
    "title": "Events API",
    "description": "Documentation for the events routes",
    "version": "1.0.0"
  },
  "host": "cse341-briggs-history-timeline.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "paths": {
    "/events/": {
      "get": {
        "description": "",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "All events.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Event"
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      },
      "post": {
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "The event to create.",
            "schema": {
              "$ref": "#/definitions/Event"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/events/{id}": {
      "get": {
        "description": "",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested event.",
            "schema": {
              "$ref": "#/definitions/Event"
            }
          }
        }
      },
      "put": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "The event to update.",
            "schema": {
              "$ref": "#/definitions/Event"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "definitions": {
    "Event": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Fall of the Roman Empire"
        },
        "description": {
          "type": "string",
          "example": "The fall of the Western Roman Empire"
        },
        "year": {
          "type": "number",
          "example": 476
        },
        "month": {
          "type": "number",
          "example": 9
        },
        "day": {
          "type": "number",
          "example": 4
        },
        "location": {
          "type": "string",
          "example": "Rome, Italy"
        },
        "category": {
          "type": "string",
          "example": "History"
        }
      }
    }
  }
}