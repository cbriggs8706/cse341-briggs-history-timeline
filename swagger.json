{
  "swagger": "2.0",
  "info": {
    "title": "Events API",
    "description": "Documentation for the events routes",
    "version": "1.0.0"
  },
  "host": "localhost:8080",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/events/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "All events.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Event"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Unexpected database or server error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "post": {
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Required: title, description, year, location, category. Month and day are optional. Day requires month.",
            "schema": {
              "$ref": "#/definitions/Event"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Event created. Returns the MongoDB insert result."
          },
          "400": {
            "description": "Missing required fields, invalid field types, or invalid date.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Unable to create the event or an unexpected database error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/events/{id}": {
      "get": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "A 24-character hexadecimal MongoDB event ID."
          }
        ],
        "responses": {
          "200": {
            "description": "The requested event.",
            "schema": {
              "$ref": "#/definitions/Event"
            }
          },
          "400": {
            "description": "Invalid event ID.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Event not found.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "500": {
            "description": "Unexpected database or server error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "put": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "A 24-character hexadecimal MongoDB event ID."
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Required: title, description, year, location, category. Month and day are optional; omitted values remain unchanged. Extra fields are ignored.",
            "schema": {
              "$ref": "#/definitions/Event"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event updated successfully.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "400": {
            "description": "Invalid event ID or invalid event data.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Event not found.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "500": {
            "description": "Unexpected database or server error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "delete": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "A 24-character hexadecimal MongoDB event ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Event deleted successfully.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "400": {
            "description": "Invalid event ID.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Event not found.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "500": {
            "description": "Unexpected database or server error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/societies/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "All societies.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Society"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Unexpected database or server error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "post": {
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Required: name, description, startYear, region, government, religiousLandscape, historicalImpact, sources. Optional: endYear, dateNotes. Use negative years for BCE and positive years for CE; year zero is not allowed. Sources must contain at least one nonempty reference. Extra fields are ignored.",
            "schema": {
              "$ref": "#/definitions/Society"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Society created. Returns the stored society with its MongoDB ID.",
            "schema": {
              "$ref": "#/definitions/Society"
            }
          },
          "400": {
            "description": "Missing required fields, invalid field types, or invalid year range.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Unable to create the society or an unexpected database error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/societies/{id}": {
      "get": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "A 24-character hexadecimal MongoDB society ID."
          }
        ],
        "responses": {
          "200": {
            "description": "The requested society.",
            "schema": {
              "$ref": "#/definitions/Society"
            }
          },
          "400": {
            "description": "Invalid society ID.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Society not found.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "500": {
            "description": "Unexpected database or server error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "put": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "A 24-character hexadecimal MongoDB society ID."
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Replaces the society while preserving its MongoDB ID. Required: name, description, startYear, region, government, religiousLandscape, historicalImpact, sources. Optional: endYear, dateNotes. Omitted optional fields are removed. Use negative years for BCE and positive years for CE; year zero is not allowed. Extra fields are ignored.",
            "schema": {
              "$ref": "#/definitions/Society"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Society updated successfully.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "400": {
            "description": "Invalid society ID or invalid society data.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Society not found.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "500": {
            "description": "Unexpected database or server error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "delete": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "A 24-character hexadecimal MongoDB society ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Society deleted successfully.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "400": {
            "description": "Invalid society ID.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Society not found.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "500": {
            "description": "Unexpected database or server error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Event": {
      "type": "object",
      "required": [
        "title",
        "description",
        "year",
        "location",
        "category"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Required. Must contain non-whitespace text.",
          "example": "Fall of the Roman Empire"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Required. Must contain non-whitespace text.",
          "example": "The fall of the Western Roman Empire"
        },
        "year": {
          "type": "integer",
          "description": "Required. Must be an integer.",
          "example": 476
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "Optional. Required when day is provided.",
          "example": 9
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31,
          "description": "Optional. Must be valid for the selected month and year, including leap years.",
          "example": 4
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "description": "Required. Must contain non-whitespace text.",
          "example": "Rome, Italy"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "Required. Must contain non-whitespace text.",
          "example": "History"
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": "year is required and must be an integer."
        }
      }
    },
    "Message": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "example": "Event not found"
        }
      }
    },
    "Society": {
      "type": "object",
      "required": [
        "name",
        "description",
        "startYear",
        "region",
        "government",
        "religiousLandscape",
        "historicalImpact",
        "sources"
      ],
      "properties": {
        "_id": {
          "type": "string",
          "readOnly": true,
          "description": "MongoDB ID generated by the database.",
          "example": "507f1f77bcf86cd799439011"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Required. Must contain non-whitespace text.",
          "example": "Ancient Egypt"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Required. Overview of the society and its historical significance.",
          "example": "A civilization centered along the Nile River in northeastern Africa."
        },
        "startYear": {
          "type": "integer",
          "description": "Required. Negative values represent BCE; positive values represent CE. Zero is not allowed.",
          "example": -3100
        },
        "endYear": {
          "type": "integer",
          "description": "Optional. Must be an integer other than zero and cannot precede startYear. Omit for a society that still exists.",
          "example": -30
        },
        "dateNotes": {
          "type": "string",
          "minLength": 1,
          "description": "Optional. Explains approximate dates, disputed dates, or the period covered. Must contain non-whitespace text when provided.",
          "example": "Dates are approximate and describe the period from early political unification to Roman annexation."
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "description": "Required. Main geographic region or homeland. Must contain non-whitespace text.",
          "example": "Nile Valley and Nile Delta, northeastern Africa"
        },
        "government": {
          "type": "string",
          "minLength": 1,
          "description": "Required. Political organization and significant changes over time. Must contain non-whitespace text.",
          "example": "Kingship under pharaohs, with periods of centralized rule, fragmentation, and foreign dynasties."
        },
        "religiousLandscape": {
          "type": "string",
          "minLength": 1,
          "description": "Required. Religious traditions, institutions, and developments within the society. Must contain non-whitespace text.",
          "example": "Diverse traditions involving many deities, temple institutions, royal religious roles, and beliefs about the afterlife."
        },
        "historicalImpact": {
          "type": "string",
          "minLength": 1,
          "description": "Required. Major contributions, influences, and effects on other societies. Must contain non-whitespace text.",
          "example": "Lasting influence through monumental architecture, writing, artistic traditions, and interaction with neighboring societies."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "description": "Required. At least one reference supporting the record. Every entry must contain non-whitespace text.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "example": [
            "Author, title, publication year, and relevant pages or URL"
          ]
        }
      }
    }
  }
}